---
import Base from './Base.astro';
import { eraFor } from '../data/eras';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'life'>; }
const { entry } = Astro.props;
const d = entry.data;
const marked = (await import('marked')).marked;
---
<Base title={`${d.title} — AK Wong Made`} current="life">
  <article class="life wrap wrap--narrow">
    <div class="mono-label">{d.era ?? eraFor(d.year)} &mdash; {d.year}</div>
    <h1>{d.title}</h1>
    {d.blocks.length > 0 ? d.blocks.map(b => (
      <section class="block">
        {b.image && (
          <figure>
            <img class="hero" src={b.image} alt={b.caption ?? d.title} />
            {b.caption && <figcaption>{b.caption}</figcaption>}
          </figure>
        )}
        <div class="prose" set:html={marked.parse(b.body)}></div>
      </section>
    )) : (
      <>
        {d.image && <img class="hero" src={d.image} alt={d.imageAlt ?? d.title} />}
        <div class="prose"><slot /></div>
      </>
    )}
    <p style="margin-top: var(--stack);"><a href="/life/">&larr; Back to timeline</a></p>
  </article>
</Base>

<style>
  .life { padding: calc(var(--stack) * 0.9) 0 var(--stack); }
  h1 {
    font: 800 var(--step-3)/1 var(--display);
    color: var(--brand);
    letter-spacing: -0.025em;
    margin: 0 0 2rem; max-width: 22ch;
  }
  .hero {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--line); border-radius: var(--radius);
    margin: 0 0 2rem;
  }
  .block { margin: 0 0 2.5rem; }
  figure { margin: 0 0 1.5rem; }
  figcaption {
    font: 500 var(--step--1)/1.4 var(--mono);
    color: var(--text-mute);
    margin-top: 0.6rem;
  }
  .hero { margin-bottom: 0; }
  .prose :global(p) { line-height: 1.75; margin: 0 0 1.2rem; font-size: var(--step-1); }
  .prose :global(h2) { font: 700 var(--step-2)/1.1 var(--display); color: var(--brand); margin: 2.5rem 0 0.8rem; }
</style>
