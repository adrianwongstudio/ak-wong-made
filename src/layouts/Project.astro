---
import Base from './Base.astro';
import Lightbox from '../components/Lightbox.astro';
import { marked } from 'marked';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const d = project.data;

marked.setOptions({ gfm: true, breaks: false });
const renderMd = (s: string) => marked.parse(s) as string;
---
<Base title={`${d.title} — AK Wong Made`} description={`${d.client} · ${d.year}`} current="work">
  <article class="case">
    <div class="wrap head">
      <div class="mono-label">Case study &mdash; {d.year}</div>
      <h1>{d.title}</h1>
      <p class="teaser">{d.teaser}</p>
      <div class="meta">
        <div><span>Client</span>{d.client}</div>
        <div><span>Stack</span>{d.stack.join(', ')}</div>
        <div><span>Services</span>{d.services.join(', ')}</div>
        {d.liveUrl && <div><span>Live</span><a href={d.liveUrl} rel="noopener">{new URL(d.liveUrl).host}</a></div>}
      </div>
    </div>

    <div class="wrap sections">
      {(() => {
        // Group the flat blocks list into chapters. Whenever a block has a
        // chapterTitle, a new chapter starts and includes all subsequent
        // blocks until the next chapterTitle.
        const chapters: { title?: string; blocks: typeof d.blocks }[] = [];
        for (const b of d.blocks) {
          if (b.chapterTitle || chapters.length === 0) {
            chapters.push({ title: b.chapterTitle, blocks: [b] });
          } else {
            chapters[chapters.length - 1].blocks.push(b);
          }
        }
        return chapters.map(chapter => (
          <section class="chapter">
            {chapter.title && <h2 class="chapter-title">{chapter.title}</h2>}
            {chapter.blocks.map((b, i) => (
              <div class:list={['row', i % 2 === 1 && 'reversed', !b.image && 'no-image']}>
                {b.image && (
                  <div class="image-side">
                    <a
                      href={b.image}
                      class="zoomable"
                      data-lightbox
                      data-src={b.image}
                      data-alt={chapter.title ?? d.title}
                      data-caption={b.caption ?? ''}
                      aria-label="Expand image"
                    >
                      <img src={b.image} alt={chapter.title ?? d.title} loading="lazy" />
                    </a>
                    {b.caption && <p class="cap">{b.caption}</p>}
                  </div>
                )}
                <div class="text-side">
                  <div class="prose" set:html={renderMd(b.body)}></div>
                </div>
              </div>
            ))}
          </section>
        ));
      })()}
    </div>

    <div class="wrap wrap--narrow foot">
      <a href="/work/">&larr; All projects</a>
    </div>
  </article>
  <Lightbox />
</Base>

<style>
  .case { padding: calc(var(--stack) * 0.9) 0 var(--stack); }
  .head { margin-bottom: calc(var(--stack) * 0.6); }
  h1 {
    font: 800 var(--step-3)/1 var(--display);
    color: var(--brand);
    letter-spacing: -0.025em;
    margin: 0 0 1.5rem;
    max-width: 18ch;
  }
  .teaser {
    font-size: var(--step-1);
    color: var(--text);
    line-height: 1.55;
    max-width: 70ch;
    margin: 0 0 2.5rem;
  }
  .meta {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
  }
  @media (max-width: 820px) {
    .meta { grid-template-columns: repeat(2, 1fr); }
  }
  .meta span {
    display: block;
    font: 500 var(--step--1)/1 var(--mono);
    color: var(--accent);
    letter-spacing: 0.15em; text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .sections .chapter {
    margin-bottom: calc(var(--stack) * 1.2);
  }
  .sections .chapter:last-child { margin-bottom: 0; }
  .sections .chapter-title {
    font: 800 var(--step-2)/1.05 var(--display);
    color: var(--brand);
    letter-spacing: -0.02em;
    margin: 0 0 calc(var(--stack) * 0.5);
    max-width: 780px;
    margin-left: auto; margin-right: auto;
  }
  .sections .row {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3.5rem;
    align-items: center;
    margin-bottom: calc(var(--stack) * 0.7);
  }
  .sections .row:last-child { margin-bottom: 0; }
  .sections .row.reversed .image-side { grid-column: 2; grid-row: 1; }
  .sections .row.reversed .text-side  { grid-column: 1; grid-row: 1; }
  .sections .row.no-image { grid-template-columns: 1fr; max-width: 780px; margin-left: auto; margin-right: auto; }

  @media (max-width: 820px) {
    .sections .row { grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: var(--stack); }
    .sections .row.reversed .image-side,
    .sections .row.reversed .text-side { grid-column: 1; grid-row: auto; }
  }

  .zoomable {
    display: block;
    border: none;
    cursor: zoom-in;
    transition: transform .2s ease;
  }
  .zoomable:hover { transform: translateY(-2px); }
  .image-side img {
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    display: block;
    padding: 1rem;
    box-sizing: border-box;
  }
  .cap {
    text-align: center;
    margin: 0.6rem 0 0;
    font-size: var(--step--1);
    color: var(--text-mute);
    font-style: italic;
  }

  .prose :global(p) { line-height: 1.7; margin: 0 0 1rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(ul), .prose :global(ol) { line-height: 1.7; padding-left: 1.2rem; margin: 0 0 1rem; }
  .prose :global(ul li), .prose :global(ol li) { margin-bottom: 0.3rem; }
  .prose :global(strong) { color: var(--brand); font-weight: 700; }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.92em;
    background: var(--surface);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }

  .foot { margin-top: calc(var(--stack) * 0.6); }
</style>
