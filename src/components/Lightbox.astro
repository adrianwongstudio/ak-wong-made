---
---
<dialog id="lightbox" class="lightbox">
  <button class="close" aria-label="Close" data-close>&times;</button>
  <img id="lightbox-img" alt="" />
  <p id="lightbox-caption" class="caption"></p>
</dialog>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const cap = document.getElementById('lightbox-caption')!;
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const trigger = t.closest('[data-lightbox]') as HTMLAnchorElement | null;
    if (trigger) {
      e.preventDefault();
      img.src = trigger.dataset.src ?? trigger.href;
      img.alt = trigger.dataset.alt ?? '';
      cap.textContent = trigger.dataset.caption ?? '';
      dlg.showModal();
      return;
    }
    if (t.matches('[data-close]') || t === dlg) dlg.close();
  });
</script>

<style>
  .lightbox {
    border: none; padding: 0;
    background: transparent; color: var(--text);
    max-width: 92vw; max-height: 92vh;
  }
  /* Dim + blur the page behind, but keep it visible — a soft frame around
     the image rather than a solid backdrop. */
  .lightbox::backdrop {
    background: rgba(43, 43, 43, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .lightbox img {
    max-width: 92vw;
    max-height: 78vh;
    border-radius: var(--radius);
    box-shadow: 0 24px 60px rgba(0,0,0,0.45);
  }
  .close {
    position: absolute; top: -3rem; right: 0;
    background: transparent; border: none;
    color: var(--ivory);
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover { color: var(--accent); }
  .caption {
    text-align: center;
    margin: 1rem auto 0;
    max-width: 60ch;
    font: 500 var(--step-1)/1.3 var(--body);
    color: var(--ivory);
    letter-spacing: 0;
    text-transform: none;
  }
</style>
