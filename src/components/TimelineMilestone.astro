---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'life'>; hasDetail?: boolean; }
const { entry, hasDetail = true } = Astro.props;
const d = entry.data;
const slug = entry.id.replace(/\.md$/, '');
const isBirth = d.type === 'birth';
const category = d.category ?? 'career';
---
{isBirth ? (
  <div class="birth">
    <div class="year">&mdash; {d.year}</div>
    <h2>{d.title}</h2>
  </div>
) : (
  <article class:list={['milestone', `cat-${category}`, d.featured && 'featured']}>
    <div class="year">&mdash; {d.year}</div>
    <h3>{d.title}</h3>
    <div class="card">
      {d.image && (
        <div class="img" data-caption={d.title}></div>
      )}
      <div class="body">
        <slot />
        {hasDetail && (
          <a href={`/life/${slug}/`} class="more">Read the fuller story &rarr;</a>
        )}
      </div>
    </div>
  </article>
)}

<style>
  .milestone {
    position: relative;
    padding-bottom: 3rem;
  }
  /* Column placement: work → left grid col, volunteer → right */
  .milestone.cat-career      { grid-column: 1; }
  .milestone.cat-volunteer { grid-column: 2; }

  /* Horizontal connector line + dot on the center spine.
     Left-side (work) → connector extends right past the card into the gutter.
     Right-side (volunteer) → connector extends left. */
  .milestone::before {
    content: "";
    position: absolute;
    top: 14px;
    height: 2px;
    background: var(--brand);
    width: 2.5rem;
  }
  .milestone.cat-career::before      { right: -2.5rem; }
  .milestone.cat-volunteer::before { left:  -2.5rem; }
  .milestone::after {
    content: "";
    position: absolute;
    top: 8px;
    width: 14px; height: 14px;
    background: var(--bg);
    border: 2.5px solid var(--brand);
    border-radius: 50%;
    z-index: 2;
  }
  .milestone.cat-career::after      { right: calc(-2.5rem - 7px); }
  .milestone.cat-volunteer::after { left:  calc(-2.5rem - 7px); }

  .year {
    font: 500 var(--step--1)/1 var(--mono);
    color: var(--accent);
    letter-spacing: 0.16em;
    margin-bottom: 0.5rem;
  }
  h3 {
    font: 700 1.55rem/1.15 var(--display);
    color: var(--brand);
    letter-spacing: -0.015em; margin: 0 0 1rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .img {
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, var(--bg) 0%, var(--surface) 100%);
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .img::after {
    content: attr(data-caption);
    position: absolute; inset: auto 0 0.6rem 0;
    text-align: center;
    font: 500 var(--step--1)/1 var(--mono);
    color: var(--text-mute);
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .body { padding: 1.5rem 1.75rem 1.75rem; }
  .body :global(p) { margin: 0 0 1rem; line-height: 1.6; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .more {
    display: inline-flex; align-items: center; gap: 0.35rem;
    margin-top: 0.6rem;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .featured .card { background: var(--bg); }
  .featured .img {
    background: linear-gradient(135deg, var(--brand) 0%, var(--brand-ink) 100%);
  }
  .featured .img::after { color: var(--accent); }

  /* Birth is a special centered marker spanning both columns */
  .birth {
    grid-column: 1 / -1;
    position: relative;
    text-align: center;
    padding: 1.5rem 0;
    margin-top: 2rem;
  }
  .birth::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px; height: 26px;
    background: var(--emphasis);
    border: 3px solid var(--bg);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--emphasis);
  }
  .birth .year { color: var(--emphasis); margin-bottom: 0.35rem; position: relative; z-index: 1; }
  .birth h2 {
    font: 700 var(--step-1)/1.05 var(--display);
    color: var(--text); margin: 0;
    position: relative; z-index: 1;
  }

  /* Mobile: single column, spine on left, connector dots point right */
  @media (max-width: 780px) {
    .milestone { grid-column: 1 !important; padding-left: 40px; }
    .milestone.cat-volunteer::before,
    .milestone.cat-career::before {
      left: -20px; right: auto;
      width: 20px;
    }
    .milestone.cat-volunteer::after,
    .milestone.cat-career::after {
      left: -28px; right: auto;
    }
    .birth { grid-column: 1 !important; text-align: left; padding-left: 40px; }
    .birth::before { left: -8px; transform: translateY(-50%); }
  }
</style>
