---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; index: number; }
const { project, index } = Astro.props;
const d = project.data;
const slug = project.id.replace(/\.md$/, '');
const href = d.hasCaseStudy ? `/work/${slug}/` : d.liveUrl!;
const external = !d.hasCaseStudy;
const reversed = index % 2 === 1;

// Map schema value → filter chip label (for clickable category)
const chipLabel: Record<string, string> = {
  'Automation': 'Automation',
  'Website':    'Websites',
  'Web App':    'Web Apps',
};
---
<article class:list={['row', reversed && 'reversed']}>
  <a href={href} rel={external ? 'noopener' : undefined} class="image-link">
    <div class="image">
      <div class="mark">{d.title}</div>
    </div>
  </a>
  <div class="text">
    <div class="client">Client &mdash; {d.client}</div>
    <h2><a href={href} rel={external ? 'noopener' : undefined}>{d.title}</a></h2>
    <div class="cats">
      {d.services.map(s => (
        <a href={`/work/?type=${encodeURIComponent(chipLabel[s] ?? s)}`} class="cat">{chipLabel[s] ?? s}</a>
      ))}
    </div>
    <p class="teaser">{d.teaser}</p>
    <p class="more">
      <a href={href} rel={external ? 'noopener' : undefined}>
        {d.hasCaseStudy ? 'Read more' : 'Visit live site'} &rarr;
      </a>
    </p>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3.5rem;
    align-items: center;
    margin-bottom: calc(var(--stack) * 0.9);
  }
  .row.reversed .image-link { grid-column: 2; grid-row: 1; }
  .row.reversed .text { grid-column: 1; grid-row: 1; }
  @media (max-width: 820px) {
    .row { grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: var(--stack); }
    .row.reversed .image-link,
    .row.reversed .text { grid-column: 1; grid-row: auto; }
  }

  .image-link { display: block; border: none; }
  .image {
    aspect-ratio: 16/10;
    background: linear-gradient(135deg, var(--brand) 0%, var(--brand-ink) 100%);
    border-radius: var(--radius);
    position: relative; overflow: hidden;
    transition: transform .2s ease;
  }
  .image-link:hover .image { transform: translateY(-2px); }
  .image::after {
    content: "";
    position: absolute; inset: 0;
    background:
      repeating-linear-gradient(45deg,
        rgba(255,255,255,0.04) 0 10px, transparent 10px 22px);
  }
  .mark {
    position: absolute; inset: auto 1.75rem 1.75rem 1.75rem;
    color: var(--text-invert);
    font: 800 clamp(1.6rem, 1rem + 2.2vw, 2.8rem)/1 var(--display);
    letter-spacing: -0.02em;
    z-index: 2;
  }

  .text .client {
    font: 500 var(--step--1)/1 var(--mono);
    color: var(--accent);
    letter-spacing: 0.16em; text-transform: uppercase;
    margin: 0 0 0.9rem;
  }
  .text h2 {
    font: 800 var(--step-2)/1.02 var(--display);
    color: var(--brand);
    letter-spacing: -0.025em;
    margin: 0 0 1rem;
  }
  .text h2 a { color: inherit; border: none; }
  .text h2 a:hover { color: var(--brand-ink); }

  .cats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.4rem; }
  .cat {
    display: inline-flex; align-items: center;
    padding: 0.35rem 0.75rem;
    font: 500 var(--step--1)/1 var(--body);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    text-decoration: none;
  }
  .cat:hover {
    background: var(--brand); color: var(--text-invert); border-color: var(--brand);
  }

  .teaser {
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--text);
    max-width: 42ch;
    margin: 0 0 1.5rem;
  }
  .more {
    margin: 0;
    font: 600 var(--step-0)/1 var(--body);
  }
  .more a { color: var(--brand); }
  .more a:hover { color: var(--brand-ink); }
</style>
